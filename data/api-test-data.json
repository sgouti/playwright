{
  "userApiTests": [
    {
      "testName": "Get user by valid ID",
      "endpoint": "/api/users/1",
      "method": "GET",
      "payload": null,
      "expectedStatus": 200,
      "expectedFields": ["id", "username", "email", "role"]
    },
    {
      "testName": "Create new user",
      "endpoint": "/api/users",
      "method": "POST",
      "payload": {
        "username": "newuser@example.com",
        "password": "password123",
        "role": "user"
      },
      "expectedStatus": 201,
      "expectedFields": ["id", "username", "email", "role"]
    },
    {
      "testName": "Update existing user",
      "endpoint": "/api/users/1",
      "method": "PUT",
      "payload": {
        "username": "updated@example.com",
        "role": "admin"
      },
      "expectedStatus": 200,
      "expectedFields": ["id", "username", "email", "role"]
    },
    {
      "testName": "Delete user",
      "endpoint": "/api/users/1",
      "method": "DELETE",
      "payload": null,
      "expectedStatus": 204,
      "expectedFields": []
    },
    {
      "testName": "Get user with invalid ID",
      "endpoint": "/api/users/999",
      "method": "GET",
      "payload": null,
      "expectedStatus": 404,
      "expectedFields": []
    }
  ],
  "productApiTests": [
    {
      "testName": "Get all products",
      "endpoint": "/api/products",
      "method": "GET",
      "payload": null,
      "expectedStatus": 200,
      "expectedFields": ["products", "total", "page"]
    },
    {
      "testName": "Search products",
      "endpoint": "/api/products?search=laptop",
      "method": "GET",
      "payload": null,
      "expectedStatus": 200,
      "expectedFields": ["products", "total", "page"]
    }
  ]
}