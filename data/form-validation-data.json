{
  "formValidationTests": [
    {
      "testName": "Valid form submission",
      "formData": {
        "firstName": "John",
        "lastName": "Doe",
        "email": "john.doe@example.com",
        "phone": "+1234567890",
        "age": 25
      },
      "expectedResult": "success",
      "expectedMessage": "Form submitted successfully"
    },
    {
      "testName": "Missing required field - firstName",
      "formData": {
        "firstName": "",
        "lastName": "Doe",
        "email": "john.doe@example.com",
        "phone": "+1234567890",
        "age": 25
      },
      "expectedResult": "error",
      "expectedMessage": "First name is required"
    },
    {
      "testName": "Invalid email format",
      "formData": {
        "firstName": "John",
        "lastName": "Doe",
        "email": "invalid-email",
        "phone": "+1234567890",
        "age": 25
      },
      "expectedResult": "error",
      "expectedMessage": "Please enter a valid email address"
    },
    {
      "testName": "Age below minimum",
      "formData": {
        "firstName": "John",
        "lastName": "Doe",
        "email": "john.doe@example.com",
        "phone": "+1234567890",
        "age": 17
      },
      "expectedResult": "error",
      "expectedMessage": "Age must be 18 or older"
    },
    {
      "testName": "Invalid phone format",
      "formData": {
        "firstName": "John",
        "lastName": "Doe",
        "email": "john.doe@example.com",
        "phone": "invalid-phone",
        "age": 25
      },
      "expectedResult": "error",
      "expectedMessage": "Please enter a valid phone number"
    }
  ]
}