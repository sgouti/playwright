{
  "userQueries": [
    {
      "testName": "Get user by valid ID",
      "query": "SELECT * FROM users WHERE id = ?",
      "parameters": [1],
      "expectedRowCount": 1,
      "expectedFields": ["id", "username", "email", "role", "created_at"],
      "expectedResult": "success"
    },
    {
      "testName": "Get users by role",
      "query": "SELECT * FROM users WHERE role = ?",
      "parameters": ["admin"],
      "expectedRowCount": 2,
      "expectedFields": ["id", "username", "email", "role"],
      "expectedResult": "success"
    },
    {
      "testName": "Insert new user",
      "query": "INSERT INTO users (username, email, role) VALUES (?, ?, ?)",
      "parameters": ["newuser@example.com", "newuser@example.com", "user"],
      "expectedRowCount": 0,
      "expectedResult": "success",
      "operation": "insert"
    },
    {
      "testName": "Update user role",
      "query": "UPDATE users SET role = ? WHERE id = ?",
      "parameters": ["admin", 1],
      "expectedRowCount": 0,
      "expectedResult": "success",
      "operation": "update"
    },
    {
      "testName": "Delete user",
      "query": "DELETE FROM users WHERE id = ?",
      "parameters": [999],
      "expectedRowCount": 0,
      "expectedResult": "success",
      "operation": "delete"
    }
  ],
  "performanceQueries": [
    {
      "testName": "Large dataset query",
      "query": "SELECT COUNT(*) as total FROM users",
      "parameters": [],
      "expectedMaxExecutionTime": 1000,
      "expectedResult": "success"
    },
    {
      "testName": "Complex join query",
      "query": "SELECT u.username, p.title FROM users u JOIN posts p ON u.id = p.user_id WHERE u.role = ?",
      "parameters": ["admin"],
      "expectedMaxExecutionTime": 2000,
      "expectedResult": "success"
    }
  ]
}